<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      許可(パーミッション)= 「この機能を使わせてください」と端末に申告するもの。
      ここに書いていない機能はアプリから触れない。
      実際に使う瞬間に、端末が利用者へ確認ダイアログを出す。
    -->

    <!-- 通信。サーバー上のアプリを表示するので必須。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- スキャン(街の言葉を撮る)。このアプリの中心機能。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 復習の発話チェック(話した内容を文字にする)。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      位置情報。「撮った場所」を地図に残すため。

      ## FINE を宣言から外そうとして、戻した
      このアプリは3か所とも `enableHighAccuracy: false` で呼んでいる —
      一度も精密な位置を使っていない。だから COARSE だけにしようとしたが、
      **それをすると Android で位置情報が丸ごと取れなくなる**:

      - Capacitor の Geolocation は `location` という別名で COARSE+FINE の
        両方を見る。`place-reminder.ts` はこれを見て `requestPermissions()`
        を呼ぶので、FINE が宣言に無いと Capacitor 側が例外を投げ、
        `getCurrentPosition()` が常に null を返す。
      - WebView の `navigator.geolocation` も、Android 12 未満では
        COARSE だけへの切り下げをしない(minSdk は 24)。

      つまり「使わないから外す」は、ここでは動かなくなるだけだった。
      宣言は両方置き、**実際の精度は呼び出し側で落とす**。Android 12 以降は
      許可の画面に「おおよその位置」の選択肢が出るので、渡す精度は
      ユーザーが決められる。
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 「ここで撮ったこれ覚えてる?」の通知(Android 13以降は明示が必要)。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      カメラが無い端末(一部のタブレット)でもインストールできるようにする。
      required="true" にすると、そうした端末はストアに表示されなくなる。
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
</manifest>
